# KONNECT 환경변수 예시 — 실제 값은 넣지 말고, 복사해서 .env 로 쓸 것
# cp .env.example .env  (그리고 .env 는 절대 커밋하지 않는다)

# ─────────────── App ───────────────
APP_ENV=development                      # development | production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 프론트 → 백엔드 CORS 허용 오리진 (쉼표 구분)
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# 프론트가 호출할 백엔드 베이스 URL (프론트 빌드/설정용)
API_BASE_URL=http://localhost:8000

# ─────────────── OpenAI (LangChain) ───────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o                      # 추론 모델명 (확정 시 갱신)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # RAG 임베딩 모델
# (선택) LangChain 트레이싱 — LangSmith 사용 시
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=konnect

# ─────────────── Supabase (DB · pgvector · Auth · 상태저장) ───────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=                       # 프론트에서 사용하는 공개 키
SUPABASE_SERVICE_ROLE_KEY=               # 백엔드 전용 — 절대 프론트/클라이언트 노출 금지
SUPABASE_JWT_SECRET=                     # 백엔드가 Supabase 세션 JWT를 검증할 때 사용
# 참고: Supabase Auth가 Google OAuth를 처리하므로 Google client id/secret은
#       코드/.env 가 아니라 Supabase 대시보드(Authentication > Providers)에 입력한다.
#       비회원→로그인 마이그레이션을 위해 Anonymous Sign-in 토글도 대시보드에서 ON.

# ─────────────── 지도 · 이동 ───────────────
# Naver Maps (프론트 지도 렌더링)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
# Tmap (도보 경로·거리·시간 — 백엔드 프록시)
TMAP_API_KEY=
# Google Maps 외부 딥링크는 키 불필요 (URL 스킴). 필요 시 추가.
# Google Places API (New) — 보조 장소정보 (공식 API 우선, 부족 시 보강)
# 개발: Maps Demo Key / 배포: 결제 연결 정식 키(무료 티어). 키만 교체, 코드 불변.
GOOGLE_PLACES_API_KEY=

# ─────────────── 공식 데이터 API ───────────────
# 한국관광공사 TourAPI (EngService2)
TOURAPI_KEY=
# 서울 열린데이터광장 — 서울문화포털 문화행사 API (culturalEventInfo)
SEOUL_OPENAPI_KEY=
# KOPIS 공연예술통합전산망
KOPIS_API_KEY=
# 기상청 (단기예보 등)
KMA_API_KEY=
# AirKorea (대기질)
AIRKOREA_API_KEY=
