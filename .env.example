# KONNECT 환경변수 예시 — 실제 값은 넣지 말고, 복사해서 .env 로 쓸 것
# cp .env.example .env  (그리고 .env 는 절대 커밋하지 않는다)

# ─────────────── App ───────────────
# ⚠ 로컬(.env)과 배포(Render/Vercel 대시보드)는 값을 분리한다. 아래는 로컬 기본값.
#   배포에서 반드시 바꿀 것: APP_ENV=production · CORS_ALLOW_ORIGINS=<Vercel URL>.
#   키(OpenAI/Supabase/TourAPI/Tmap/Naver/Places/DB_URL)는 로컬·배포 같은 값 사용 가능.
APP_ENV=development                      # development | production
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000                        # 로컬용. Render는 $PORT 를 자동 주입(start 명령 참고).
# 프론트 → 백엔드 CORS 허용 오리진 (쉼표 구분). 배포: https://<app>.vercel.app 추가.
CORS_ALLOW_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# 참고용(백엔드 미사용). 프론트의 백엔드 URL은 frontend/js/config.js 가 호스트로 자동 전환.
API_BASE_URL=http://localhost:8000

# ─────────────── OpenAI (LangChain) ───────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o                      # 추론·판정 설명 모델명
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # RAG 임베딩 모델

# ─────────────── Agent (while-loop §6) ───────────────
AGENT_LOOP=false                         # true 면 /api/chat 이 agentic 루프 사용(기본: 단일 라우팅 fallback)
ORCHESTRATOR_MODEL=gpt-4o-mini           # 루프의 tool 선택 전용 모델(지연↓). 사실·판정은 코드 소유. 빈 값이면 OPENAI_MODEL

# [선택 · Optional] LangSmith 트레이싱 — LangChain 동작 자체엔 불필요.
#   다단계 Agent 관측·디버깅·PoC 증빙용. 안 쓰면 비워두고 TRACING_V2=false 유지.
#   쓰려면 smith.langchain.com 가입 → API 키 발급 → TRACING_V2=true.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=konnect

# ─────────────── Supabase (DB · pgvector · Auth · 상태저장) ───────────────
# 키 위치: 대시보드 Settings > API Keys (2025 신규 키 체계). URL은 Settings > API 또는 Connect.
SUPABASE_URL=                            # https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=                # 프론트용 공개 키 (sb_publishable_... / 구 anon)
SUPABASE_SECRET_KEY=                     # 백엔드 전용 (sb_secret_... / 구 service_role) — 절대 노출 금지
SUPABASE_DB_URL=                         # RAG(vecs/pgvector) 전용 Postgres 직결 DSN. 대시보드 Connect > ORM/Session pooler URI
#   예: postgresql://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#   (REST 키로는 벡터 upsert/query 불가 → RAG에만 사용. 미설정 시 /api/ask 만 503, 추천·세션 무영향)
# JWT 검증: 신규 프로젝트는 비대칭 서명키 → JWKS로 로컬 검증(별도 secret 불필요).
#   JWKS endpoint: {SUPABASE_URL}/auth/v1/.well-known/jwks.json
#   (레거시 '대칭' 프로젝트만 공유 secret 사용 — 그 경우에만 SUPABASE_JWT_SECRET= 를 추가)
# 참고: Google OAuth는 대시보드 Authentication > Providers에 client id/secret 입력(코드/.env 아님).
#       비회원→로그인 마이그레이션용 Anonymous Sign-in 토글도 대시보드에서 ON.
#       RAG용 pgvector는 Database > Extensions에서 'vector' 확장 활성화.

# ─────────────── 지도 · 이동 ───────────────
# Naver Maps — 프론트 지도 렌더링(Web Dynamic Map, JS SDK v3)
# 스크립트 URL에 ncpKeyId=<이 값>으로 사용. Client Secret은 불필요
# (서버 REST API-Geocoding/Directions/Static Map-를 쓰지 않음. 경로는 Tmap 사용)
# ※ 공개 식별자이므로 NCP 콘솔에서 Web 서비스 URL 등록으로 도메인 제한.
NAVER_MAP_CLIENT_ID=
# Tmap (도보 경로·거리·시간 — 백엔드 프록시)
TMAP_API_KEY=
# Google Maps 외부 딥링크는 키 불필요 (URL 스킴). 필요 시 추가.
# Google Places API (New) — 보조 장소정보 (공식 API 우선, 부족 시 보강)
# 개발: Maps Demo Key / 배포: 결제 연결 정식 키(무료 티어). 키만 교체, 코드 불변.
GOOGLE_PLACES_API_KEY=

# ─────────────── 공식 데이터 API ───────────────
# 공공데이터포털(data.go.kr) 공용 인증키 — 아래 3개 API가 "동일 키"를 사용한다.
#   · 한국관광공사 TourAPI (영문 관광정보서비스, EngService2)
#   · 기상청 단기예보 조회서비스
#   · 한국환경공단 에어코리아 대기오염정보
# 주의: 키 값은 같지만 API별 '활용신청'은 각각 필요. Encoding/Decoding 버전 구분.
# 엔드포인트는 서로 다름(키만 공유) → sources/ 의 tourapi·kma·airkorea 클라이언트에서 각각 처리.
DATA_GO_KR_SERVICE_KEY=

# 서울 열린데이터광장(data.seoul.go.kr) — 서울문화포털 문화행사 API (culturalEventInfo)
# 별도 포털·별도 키
SEOUL_OPENAPI_KEY=
# KOPIS 공연예술통합전산망(kopis.or.kr) — 별도 포털·별도 키
KOPIS_API_KEY=
